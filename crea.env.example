# CREA 环境变量
#
# 把本文件复制成 `.env`（已经在 .gitignore 里，不会被提交），然后填值。
#   cp crea.env.example .env      # 或在 Windows 上直接重命名
#
# 填完直接用，不需要 export：
#   crea research "研究 1,4-二苯基-1,3-丁二炔的合成方法" --provider openai-compatible
#
# ⚠️ 这个文件里放的是密钥。填完不要提交，不要贴进聊天窗口。
#    项目不会把它写进 trace 或报告（tests/unit/test_llm_provider.py 有测试守）。


# ---------------------------------------------------------------------------
# 1. 大模型（必需，用 --provider openai-compatible 时）
# ---------------------------------------------------------------------------
# 任何 OpenAI 兼容端点的 key。OpenAI / OpenRouter / DeepSeek / SiliconFlow
# 或本地 vLLM 都行。
CREA_LLM_API_KEY=

# 默认 https://api.openai.com/v1。换厂商就换成它的地址。
# 例子：
#   https://openrouter.ai/api/v1
#   https://api.deepseek.com/v1
#   http://localhost:8000/v1        # 本地 vLLM
CREA_LLM_BASE_URL=

# 留空则用代码里的默认模型。想省钱或换模型就填。
# 例子：gpt-4o-mini / deepseek-chat / qwen-plus
CREA_LLM_MODEL=


# ---------------------------------------------------------------------------
# 2. 文献检索（可选）
# ---------------------------------------------------------------------------
# Unpaywall 强制要求一个联系邮箱。填了才会启用 access 查询；
# 不填只影响 access 增强，不影响检索本身。
CREA_UNPAYWALL_EMAIL=

# OpenAlex 的可选 key。keyless 请求照常可用，key 只是把每日额度提高 10 倍。
CREA_OPENALEX_API_KEY=


# ---------------------------------------------------------------------------
# 3. 开关
# ---------------------------------------------------------------------------
# 设为 1 才会跑 live 测试（`pytest -m live`）。默认不跑。
CREA_LIVE_TESTS=
